<mxfile host="app.diagrams.net" version="24.7.17">
  <diagram name="Red Button - reference Azure architecture" id="red-button-azure">
    <mxGraphModel dx="1422" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="RED BUTTON DEMO | Reference Azure architecture&#xa;MSAL + Terraform + interchangeable Commvault HTTP client" style="text;html=0;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1260" height="70" as="geometry"/></mxCell>
        <mxCell id="browser" value="Operator browser&#xa;Vite web app + MSAL&#xa;Selection / confirmation / per-server results" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="290" height="110" as="geometry"/></mxCell>
        <mxCell id="entra" value="Microsoft Entra ID&#xa;SPA + API registrations&#xa;Delegated access_as_user scope&#xa;BackupOperator app role" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;" vertex="1" parent="1"><mxGeometry x="540" y="120" width="310" height="150" as="geometry"/></mxCell>
        <mxCell id="azure" value="Azure subscription - Terraform managed" style="swimlane;html=0;startSize=40;rounded=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=17;fontStyle=1;horizontal=1;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="1050" height="510" as="geometry"/></mxCell>
        <mxCell id="backend" value="Linux App Service / Python FastAPI&#xa;Serves built web app + API&#xa;&#xa;Validate JWT signature / issuer / audience&#xa;tenant / SPA caller / scope / expiry&#xa;Operator role + explicit live-write gate&#xa;Audit every submitted server operation" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="azure"><mxGeometry x="30" y="80" width="360" height="190" as="geometry"/></mxCell>
        <mxCell id="adapter" value="Shared Commvault HTTP client&#xa;GET /V4/Servers&#xa;PUT /V4/Server/{id}/Backup/Action/Disable&#xa;&#xa;Base URL + header configuration&#xa;No redirects / no automatic retries" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="azure"><mxGeometry x="470" y="80" width="330" height="190" as="geometry"/></mxCell>
        <mxCell id="stub" value="Default: private Python HTTP stub&#xa;In-process HTTPX ASGI transport&#xa;Same endpoint paths + envelopes&#xa;Synthetic servers / in-memory state&#xa;Not exposed to public network" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="azure"><mxGeometry x="480" y="350" width="320" height="120" as="geometry"/></mxCell>
        <mxCell id="vault" value="Azure Key Vault&#xa;Live upstream credential only&#xa;App Service managed identity&#xa;No secret values in Terraform" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="azure"><mxGeometry x="30" y="340" width="270" height="130" as="geometry"/></mxCell>
        <mxCell id="client" value="Optional LIVE connection&#xa;Client Commvault deployment&#xa;Private routing / firewall as required&#xa;Client-specific auth and version&#xa;Compatibility must be verified" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1120" y="410" width="250" height="190" as="geometry"/></mxCell>
        <mxCell id="monitor" value="Azure Monitor / Log Analytics&#xa;App Service structured stdout audit events&#xa;Request ID + actor + server ID + outcome&#xa;No credentials or upstream raw error bodies" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="920" width="450" height="110" as="geometry"/></mxCell>
