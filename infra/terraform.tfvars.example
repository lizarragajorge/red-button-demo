subscription_id = "00000000-0000-0000-0000-000000000000"
app_name        = "replace-with-unique-red-button-name"
location        = "eastus2"
# Optional: place only App Service and its plan in another region with quota.
# app_service_location = "centralus"
# Stage queued resources without cutting over: activate_queued_execution = false
display_name    = "Red Button"
support_url     = ""

# User object IDs, not application/client IDs. No users are assigned by default.
operator_object_ids = []

# Organizational multi-tenant auth is opt-in. The home tenant is always allowed.
# Enable both settings together; list 1-20 additional tenant GUIDs, not domains.
# External admins own consent and BackupOperator assignments in their tenants.
enable_multi_tenant = false
allowed_tenant_ids  = []
# enable_multi_tenant = true
# allowed_tenant_ids  = ["aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa"]

service_plan_sku         = "B1"
api_assignment_required = null # Default: open demo; assignment required for live/restricted mode.
spa_assignment_required = false
commvault_mode           = "stub"
allow_signed_in_demo_operations = true
enable_live_operations   = false
# Default: provision storage and Functions; deploy both web and worker packages.
# Set enable_three_tier=false for an explicitly synchronous, non-durable demo.
enable_three_tier                  = true
activate_queued_execution          = true
enable_gateway_ingress             = false

# Storage networking switch (requires enable_three_tier=true for private mode).
# false: simpler public HTTPS endpoints; managed identity/RBAC still required.
# true: private endpoints + private DNS + outbound app VNet integration.
# Choose true when the receiving subscription requires private-only storage.
enable_private_storage_networking = false
# storage_vnet_cidr = "10.73.0.0/16" # Private mode only; choose a non-overlapping range.

# Existing APIM integration (no new paid APIM instance or API routes are created).
# Requires enable_three_tier=true, commvault_mode="live", empty commvault_base_url,
# and already-configured/verified routes, policies, backend and vault credential.
# existing_apim_base_url = "https://existing-gateway.example.com/approved-api"

# Optional HTTPS-only WAF_v2 ingress adds significant cost. Requires three-tier.
# Supply an existing certificate and arrange DNS/Key Vault network access first.
# gateway_hostname             = "backup.example.com"
# gateway_certificate_secret_id = "https://existing-vault.vault.azure.net/secrets/backup-tls"
# gateway_certificate_vault_id   = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/certificates/providers/Microsoft.KeyVault/vaults/existing-vault"
# gateway_vnet_cidr              = "10.72.0.0/16"
# gateway_subnet_cidr            = "10.72.0.0/24"
# gateway_scm_allowed_cidrs      = ["203.0.113.10/32"] # Replace with trusted deployment egress; empty denies SCM.
# Match subscription policy if it disables public vault access in stub mode.
# key_vault_public_network_access_enabled = false

# Live mode additionally needs an externally populated Key Vault secret.
# commvault_base_url    = "https://commvault.example.com/commandcenter/api"
# commvault_auth_header = "Authtoken"
# commvault_secret_name = "commvault-auth"
