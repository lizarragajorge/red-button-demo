# Copy to .env; populate IDs from Terraform outputs. Never add credentials to VITE_*.
PORT=8080
APP_ENV=development
PUBLIC_ORIGIN=http://localhost:5173
# For a built frontend served directly by Python, use http://localhost:8080.
# If corporate TLS interception requires it, set the approved public CA bundle:
# SSL_CERT_FILE=/absolute/path/to/approved-ca-bundle.pem
# Public UI settings, not secrets. Support link is hidden when empty.
APP_DISPLAY_NAME=Red Button
SUPPORT_URL=
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=
ENTRA_SPA_CLIENT_ID=
# Optional direct organizational sign-in. Home tenant stays allowed.
# Additional tenant IDs must be verified; never authorize by email suffix.
ENTRA_MULTI_TENANT=false
ENTRA_ALLOWED_TENANT_IDS=
# Multi-tenant registrations and external-tenant admin consent are required.
# BackupOperator is always required for live operations.
COMMVAULT_MODE=stub
# Any authenticated allowed-tenant user can operate the simulator by default.
# Set false to require BackupOperator for simulated operations too.
ALLOW_SIGNED_IN_DEMO_OPERATIONS=true
ENABLE_LIVE_OPERATIONS=false
# Used only in live mode. Include the client's API prefix, e.g. /commandcenter/api.
COMMVAULT_BASE_URL=
COMMVAULT_AUTH_HEADER=Authorization
# Exact header value including "Bearer " only when required by the client.
COMMVAULT_AUTH_VALUE=

# Default retains synchronous API behavior. Queued mode requires provisioned
# private Blob containers requests, inventory, coordination, stub-state and
# queues requests, requests-poison. No inventory is fabricated on API startup.
EXECUTION_MODE=sync
STORAGE_ACCOUNT_NAME=
# Local emulator ONLY; production uses ManagedIdentityCredential (no account key).
# AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
INVENTORY_REFRESH_SCHEDULE=0 */5 * * * *
INVENTORY_MAX_AGE_SECONDS=900
# Functions queue binding, separately from host storage:
# Azure: WORK_STORAGE__queueServiceUri=https://<account>.queue.core.windows.net
# Local: WORK_STORAGE=UseDevelopmentStorage=true
# AzureWebJobsStorage is separately configured for the Functions host.
# The phase-1 queued stub is internal ASGI transport with shared Blob state;
# no anonymous stub routes or external APIM transport are exposed.
